{
  "name": "xiaomi-watch-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "setup": "node scripts/setup-local.js",
    "chain": "hardhat node --hostname 127.0.0.1",
    "deploy:local": "hardhat build && node scripts/deploy-local.js",
    "configure:wallet": "node scripts/configure-wallet.js",
    "db:seed": "node scripts/seed-admin.js",
    "build": "node --check server/index.js && node --check server/vnpay.js && node --check public/app.js && node --check public/admin.js && node --check scripts/setup-local.js && node --check scripts/configure-wallet.js && node --check scripts/deploy-local.js && node --check scripts/seed-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "mysql2": "^3.14.5"
  },
  "devDependencies": { "hardhat": "^3.21.2" }
}
